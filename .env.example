# Copy to .env and fill in only the vendors you use.
# Never commit .env. Keys are read from the environment name listed
# in content/llm_providers.yaml (api_key_env).

# Local encryption of stored API keys (change this; losing it means
# stored keys cannot be decrypted).
FR_SECRET_KEY=

# Drafter default (content/llm_providers.yaml roles.drafter)
DEEPSEEK_API_KEY=

# Other presets — unused ones can stay empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
ARK_API_KEY=
HUNYUAN_API_KEY=
BAICHUAN_API_KEY=
SILICONFLOW_API_KEY=
QIANFAN_API_KEY=
SPARK_API_KEY=
STEP_API_KEY=
YI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional Docker (compose interpolates these; they are not baked into the image)
# FR_HTTP_BIND=127.0.0.1
# FR_SITE_ADDRESS=localhost
# FR_BOOTSTRAP_ADMIN_EMAIL=admin@localhost
# FR_BOOTSTRAP_ADMIN_PASSWORD=changeme
# FR_ENTRA_TENANT_ID=
# FR_ENTRA_CLIENT_ID=
# FR_ENTRA_CLIENT_SECRET=
# FR_ENTRA_REDIRECT_URI=https://your.domain/auth/entra/callback
